{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ops-platform.local/schemas/plugin-manifest.json",
  "title": "运维平台插件清单（plugin.yaml）",
  "description": "内容必须与 plugin-spec/manifest.schema.json 保持一致；build 阶段由测试校验。",
  "type": "object",
  "required": ["identity", "version", "form", "entry", "capabilities"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["id", "display_name", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "version": {
      "type": "object",
      "required": ["plugin", "contract"],
      "properties": {
        "plugin": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contract": { "type": "string", "minLength": 1 }
      }
    },
    "form": { "enum": ["command", "daemon"] },
    "entry": {
      "type": "object",
      "properties": {
        "executable": { "type": "string" },
        "launch": { "type": "string" },
        "socket": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "input_schema_ref",
          "output_schema_ref",
          "idempotent",
          "long_running",
          "supports_cancel",
          "concurrency",
          "sensitive"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "input_schema_ref": { "type": "string", "minLength": 1 },
          "output_schema_ref": { "type": "string", "minLength": 1 },
          "idempotent": { "type": "boolean" },
          "long_running": { "type": "boolean" },
          "suggested_timeout_ms": { "type": "integer", "minimum": 1 },
          "supports_cancel": { "type": "boolean" },
          "concurrency": { "enum": ["parallel", "serial"] },
          "sensitive": { "type": "boolean" },
          "risk_level": { "enum": ["normal", "destructive"] }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "actions"],
        "properties": {
          "category": {
            "enum": ["config", "data_dir", "network", "filesystem", "credential", "invoke_plugin"]
          },
          "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "scope": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "max_result_bytes": { "type": "integer", "minimum": 1 },
        "resource_expectation": { "type": "string" },
        "listen": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["string", "number", "integer", "boolean", "enum"] },
          "required": { "type": "boolean" },
          "secret": { "type": "boolean" },
          "default": { "type": ["string", "number", "integer", "boolean", "array"] },
          "enum": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "description": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
            "then": { "required": ["enum"] }
          },
          {
            "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
            "then": { "not": { "required": ["default"] } }
          }
        ]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "license": { "type": "string" },
        "homepage": { "type": "string" },
        "docs": { "type": "string" }
      }
    },

    "dependencies": false,
    "password": false,
    "passwd": false,
    "secret": false,
    "token": false,
    "credential": false,
    "credentials": false,
    "api_key": false,
    "apikey": false,
    "private_key": false,
    "access_key": false,
    "secret_key": false
  },
  "allOf": [
    {
      "if": { "properties": { "form": { "const": "command" } }, "required": ["form"] },
      "then": {
        "properties": {
          "entry": {
            "required": ["executable"],
            "properties": { "launch": false, "socket": false }
          },
          "runtime": {
            "properties": { "listen": false }
          }
        }
      }
    },
    {
      "if": { "properties": { "form": { "const": "daemon" } }, "required": ["form"] },
      "then": {
        "properties": {
          "entry": {
            "required": ["launch"],
            "properties": { "executable": false }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
